# Copy to .env.local for local testing. On Hostinger these go in hPanel as
# Environment variables (never in git). Any change there needs a new build.

# The site's address, for links in shared previews. Example: https://www.example.com
SITE_URL=

# Mailbox that sends the quote requests. For now Gmail: smtp.gmail.com, port 465, the Gmail
# address, and a Google App Password (not the normal password). Later: smtp.hostinger.com.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# Where quote requests are delivered (defaults to SMTP_USER)
LEADS_EMAIL=

# Admin panel (/admin). The password until the owner sets his own from "حسابي" (12+ characters).
ADMIN_PASSWORD=
# The owner's personal email, for the "forgot password" link and the weekly backup
ADMIN_EMAIL=
# Password that locks the weekly backup file sent by email (8+ characters; keep it safe)
BACKUP_PASSWORD=
# Optional folders (default: "mackine-data" and "mackine-backups" next to the app folder)
DATA_DIR=
BACKUP_DIR=
